        "    print(\"dense_backend:\", rag_metrics.get(\"dense_backend\"))\n",
        "    for name, report in (rag_metrics.get(\"backends\") or {}).items():\n",
        "        print(name, \"recall\", report.get(\"mean_recall\"), \"ndcg\", report.get(\"mean_ndcg\"))\n",
        "else:\n",
        "    rag_metrics = {}\n",
        "    print(\"rag_metrics.json missing\")"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Grounded generate eval (base vs adapter)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "if RUN_RAG and (RUN_TRAIN or ADAPTER_DIR.is_dir()):\n",
        "    if ADAPTER_DIR.is_dir():\n",
        "        !python scripts/eval_rag_generate.py --run --adapter-dir outputs/adapters/llama32-3b-ecra-sft\n",
        "    else:\n",
        "        !python scripts/eval_rag_generate.py --run\n",
        "        print(\"adapter missing; scored base only\")\n",
        "else:\n",
        "    !python scripts/eval_rag_generate.py\n",
        "    print(\"generate eval dry-run (placeholders). Need RUN_RAG (+ adapter preferred).\")\n",
        "\n",
        "gen_path = Path(\"evals/reports/rag_generation_metrics.json\")\n",
        "if gen_path.is_file():\n",
        "    gen_metrics = json.loads(gen_path.read_text())\n",
        "    print(\"dry_run:\", gen_metrics.get(\"dry_run\"))\n",
        "    print(\"aggregate:\", json.dumps(gen_metrics.get(\"aggregate\"), indent=2))\n",
        "else:\n",
        "    gen_metrics = {}\n",
        "    print(\"rag_generation_metrics.json missing\")"
      ],
      "outputs": [],
      "execution_count": null
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Fill `RAG_EVAL_REPORT.md` + README Results from JSON only\n",
        "\n",
        "Skips if metrics are still dry-run / missing. Never invents numbers."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def _fmt(x, digits=4):\n",
        "    if x is None:\n",
        "        return \"TBD\"\n",
        "    if isinstance(x, float):\n",
        "        return f\"{x:.{digits}f}\"\n",
        "    return str(x)\n",
        "\n",
        "def _mean_at(report, key, k):\n",
        "    # report may store mean_recall as dict {\"1\":..,\"3\":..} or list\n",
        "    val = report.get(key)\n",
        "    if isinstance(val, dict):\n",
        "        return val.get(str(k), val.get(k))\n",
        "    return val  # already aggregated mean over k's in some builds\n",
        "\n",
        "can_fill = bool(manifest) and bool(rag_metrics) and gen_metrics.get(\"dry_run\") is False\n",
        "print(\"can_fill_report:\", can_fill, \"(requires real generate eval dry_run=false)\")\n",
        "\n",
        "# Always snapshot corpus manifest into evals/reports for git (corpus dir is gitignored)\n",
        "snap = Path(\"evals/reports/corpus_manifest_snapshot.json\")\n",
        "if manifest:\n",
        "    snap.write_text(json.dumps(manifest, indent=2) + \"\\n\")\n",
        "    print(\"wrote\", snap)\n",
        "\n",
        "if can_fill:\n",
        "    n_chunks = manifest.get(\"n_chunks\", \"TBD\")\n",
        "    n_docs = manifest.get(\"n_documents\", \"TBD\")\n",
        "    version = manifest.get(\"version\", \"TBD\")\n",
        "    sources = manifest.get(\"sources\", \"TBD\")\n",
        "\n",
        "    backends = rag_metrics.get(\"backends\") or {}\n",
        "    hybrid = backends.get(\"hybrid\") or {}\n",
        "    bm25 = backends.get(\"bm25\") or {}\n",
        "    dense = backends.get(\"dense\") or {}\n",
        "\n",
        "    def row(b):\n",
        "        mr = b.get(\"mean_recall\")\n",
        "        mn = b.get(\"mean_ndcg\")\n",
        "        # Prefer per-k tables if present\n",
        "        if isinstance(mr, dict) and isinstance(mn, dict):\n",
        "            cells = []\n",
        "            for k in (1, 3, 5, 10):\n",
        "                cells.append(_fmt(mr.get(str(k), mr.get(k))))\n",
        "            for k in (1, 3, 5, 10):\n",
        "                cells.append(_fmt(mn.get(str(k), mn.get(k))))\n",
        "            return cells\n",
        "        # Fallback: single aggregate mean repeated\n",
        "        return [_fmt(mr)] * 4 + [_fmt(mn)] * 4\n",
        "\n",
        "    agg = gen_metrics.get(\"aggregate\") or {}\n",
        "    # Support either nested base/adapter or flat keys\n",
        "    base = agg.get(\"base\") or agg\n",
        "    adapter = agg.get(\"adapter\") or agg\n",
        "\n",
        "    report_md = f\"\"\"# RAG Evaluation Report (Phase 5)\n",
        "\n",
        "Date: {NOW_IST}  \n",
        "Corpus / N source: `data/rag/corpus_v0.1.0/manifest.json` (snapshot: `evals/reports/corpus_manifest_snapshot.json`)  \n",
        "Retrieval metrics: `evals/reports/rag_metrics.json`  \n",
        "Generation metrics: `evals/reports/rag_generation_metrics.json`  \n",
        "Eval set: `evals/rag_eval_set.jsonl` (seed `3407`)\n",
        "\n",
        "**Honesty rule:** numbers below are copied from the JSON artifacts produced by this run.\n",
        "\n",
        "## Corpus (N)\n",
        "\n",
        "| Field | Source key | Value |\n",
        "|-------|------------|-------|\n",
        "| N (chunks) | `n_chunks` | **{n_chunks}** |\n",
        "| Documents | `n_documents` | **{n_docs}** |\n",
        "| Version | `version` | **{version}** |\n",
        "| Sources | `sources` | `{sources}` |\n",
        "\n",
        "## Retrieval (Recall@k, nDCG@k)\n",
        "\n",
        "k ∈ {{1, 3, 5, 10}}. Binary relevance on gold `chunk_id`s.\n",
        "\n",
        "| Backend | R@1 | R@3 | R@5 | R@10 | nDCG@1 | nDCG@3 | nDCG@5 | nDCG@10 |\n",
        "|---------|-----|-----|-----|------|--------|--------|--------|---------|\n",
        "| BM25 | {' | '.join(row(bm25))} |\n",
        "| Dense | {' | '.join(row(dense))} |\n",
        "| Hybrid RRF | {' | '.join(row(hybrid))} |\n",
        "\n",
        "Metadata: `n_queries`={rag_metrics.get('n_queries')} · `n_index_docs`={rag_metrics.get('n_index_docs')} · `dense_backend`={rag_metrics.get('dense_backend')} · `dense_embed_model`={rag_metrics.get('dense_embed_model')}\n",
        "\n",
        "## Grounded generation (retrieve → generate)\n",
        "\n",
        "| Side | citation-hit | token F1 vs gold_answer | n_queries | dry_run |\n",
        "|------|-------------:|------------------------:|----------:|---------|\n",
        "| base | {_fmt(base.get('citation_hit', base.get('mean_citation_hit')))} | {_fmt(base.get('token_f1', base.get('mean_token_f1')))} | {gen_metrics.get('n_queries')} | {gen_metrics.get('dry_run')} |\n",
        "| adapter | {_fmt(adapter.get('citation_hit', adapter.get('mean_citation_hit')))} | {_fmt(adapter.get('token_f1', adapter.get('mean_token_f1')))} | {gen_metrics.get('n_queries')} | {gen_metrics.get('dry_run')} |\n",
        "\n",
        "`top_k`={gen_metrics.get('top_k')} · `adapter_dir`={gen_metrics.get('adapter_dir')}\n",
        "\n",
        "## Limitations\n",
        "\n",
        "- Public-data corpus only; N is not full SEC coverage.\n",
        "- Citation-hit is substring support against retrieved text, not numerical consistency.\n",
        "- Eval set locked with seed 3407; train pair IDs excluded.\n",
        "\n",
        "## Resume line\n",
        "\n",
        "> Hybrid retrieval (BM25 + dense) over **{n_chunks}** chunked public earnings/SEC-style passages; hybrid Recall / nDCG from `rag_metrics.json`; grounded accuracy from `rag_generation_metrics.json` (`dry_run=false`); generator fine-tuned with QLoRA (Llama-3.2-3B).\n",
        "\"\"\"\n",
        "    Path(\"evals/reports/RAG_EVAL_REPORT.md\").write_text(report_md)\n",
        "    print(\"Updated evals/reports/RAG_EVAL_REPORT.md\")\n",
        "\n",
        "    # Patch README Results table cells that say TBD for the four claim rows\n",
        "    readme = Path(\"README.md\")\n",
        "    text = readme.read_text()\n",
        "    # Simple replacements for the Results table values\n",
        "    hybrids = hybrid.get(\"mean_recall\")\n",
        "    hybridn = hybrid.get(\"mean_ndcg\")\n",
